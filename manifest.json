{
  "manifest_version": 3,
  "name": "Sidekick",
  "version": "1.0.0",
  "description": "An AI side panel that reads the page you're on and answers questions about it. Uses your own free Gemini and Groq keys.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Open Sidekick (Alt+J)",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel", "storage", "tabs", "scripting", "contextMenus"],
  "host_permissions": [
    "<all_urls>",
    "https://generativelanguage.googleapis.com/*",
    "https://api.groq.com/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+J" },
      "description": "Open Sidekick"
    }
  }
}
